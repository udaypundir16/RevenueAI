# ==============================================================================
# REVENUE RECOVERY AI - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before running Vite:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. FASTAPI BACKEND API BASE URL
# ------------------------------------------------------------------------------
# Points to the running FastAPI server.
# Development default: http://localhost:8000
# Production: Set to your deployed backend domain (e.g., https://api.revenueai.dev)
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. SUPABASE DIRECT FRONTEND CLIENT (OPTIONAL)
# ------------------------------------------------------------------------------
# WHERE TO GET:
# 1. Go to https://supabase.com/dashboard -> Select Project.
# 2. Navigate to: Project Settings -> API.
# 3. Copy "Project URL" and "anon public" key:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder_supabase_anon_key
