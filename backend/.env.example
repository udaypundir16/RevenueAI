# ==============================================================================
# REVENUE RECOVERY AI - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Allowed frontend CORS origins (comma-separated):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. LOCAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite is used by default for zero-setup local operation:
DATABASE_URL=sqlite:///./revenue_recovery.db

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# WHERE TO GET:
# 1. Sign up / log in to Razorpay Dashboard: https://dashboard.razorpay.com
# 2. Toggle to "Test Mode" in the top header.
# 3. Navigate to: Account & Settings -> API Keys -> Generate Key.
# 4. Your Key ID will look like: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key

# RAZORPAY WEBHOOK SECRET:
# WHERE TO GET:
# In Razorpay Dashboard -> Account & Settings -> Webhooks -> Add New Webhook.
# Enter your webhook URL (e.g., https://your-ngrok.io/webhooks/razorpay)
# Enter any secure passphrase in the "Secret" field and copy it below:
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. SUPABASE CLOUD DATABASE & REALTIME (OPTIONAL / DUAL-PERSISTENCE)
# ------------------------------------------------------------------------------
# WHERE TO GET:
# 1. Go to https://supabase.com/dashboard and select or create your project.
# 2. Navigate to: Project Settings -> API.
# 3. Copy "Project URL" (e.g., https://xyzcompany.supabase.co) into SUPABASE_URL.
# 4. Copy "anon public" or "service_role" key into SUPABASE_KEY / SUPABASE_SECRET_KEY.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=placeholder_supabase_anon_or_service_key
SUPABASE_ANON_KEY=placeholder_supabase_anon_key
SUPABASE_SECRET_KEY=placeholder_supabase_service_role_key

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (RECOVERY AGENT & ADAPTIVE DUNNING)
# ------------------------------------------------------------------------------
# WHERE TO GET:
# 1. Go to Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" (free tier available).
# 3. Paste the generated key below:
GEMINI_API_KEY=placeholder_gemini_api_key

# ------------------------------------------------------------------------------
# 6. DISPATCH & MOCK MODE SAFETY CONTROLS
# ------------------------------------------------------------------------------
# In MOCK_MODE=true, emails and SMS are synthesized by Gemini and stored in the
# recovery_messages table without requiring live SendGrid or Twilio accounts.
# Perfect for safe, reproducible judge hackathon demos.
MOCK_MODE=true

# ------------------------------------------------------------------------------
# 7. NOTIFICATION PROVIDERS (OPTIONAL - ONLY ACTIVE WHEN MOCK_MODE=false)
# ------------------------------------------------------------------------------
# SendGrid Email Dispatch:
# WHERE TO GET: https://app.sendgrid.com/settings/api_keys -> Create Key with "Mail Send"
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=billing@revenueai.dev

# Twilio SMS Dispatch:
# WHERE TO GET: https://console.twilio.com -> Account Info -> Account SID & Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
